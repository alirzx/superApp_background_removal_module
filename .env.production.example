# TEMPLATE ONLY: GitLab ENV_FILE (File-type variable) supplies the server .env.
# Replace API_TOKEN with a new strong secret; never commit the real .env.
# RUN_SERVICES=0 in GitLab CI is the safe default: build images, do NOT start ONNX.
# Put authenticated HTTPS ingress and rate-limits in front of UI.
APP_ENV=production
API_TOKEN=REPLACE_WITH_OPENSSL_RAND_HEX_32
API_BIND_IP=127.0.0.1
API_PORT=8001
UI_BIND_IP=127.0.0.1
UI_PORT=8082

# Project-scoped Python package mirrors used ONLY for Docker image builds.
# Liara is primary; Chabokan is attempted on installation failure.
# Not related to Hugging Face model download or Docker Hub base image pulls.
PIP_PRIMARY_INDEX_URL=https://package-mirror.liara.ir/repository/pypi/simple
PIP_FALLBACK_INDEX_URL=https://mirror2.chabokan.net/pypi/simple/

MODEL_REPO=onnx-community/BiRefNet_lite-ONNX
MODEL_REVISION=de15b22ba131738a16dff04aab8bdf8dc32e3ac1
MODEL_FILENAME=onnx/model.onnx
MODEL_SHA256=5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333

# PROVISIONAL SERVER TEST PROFILE ONLY: 8g is not a measured minimum/sufficient limit.
# Use only if the server has adequate available memory and isolation; measure peak RSS.
API_CPUS=3.0
API_MEMORY=8g
UI_CPUS=0.5
UI_MEMORY=256m
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
ENABLE_METRICS=true
