# Development: all host ports bind to loopback by default.
APP_ENV=development
API_TOKEN=
API_BIND_IP=127.0.0.1
API_PORT=8000
UI_BIND_IP=127.0.0.1
UI_PORT=8080

# Third-party ONNX conversion of ZhengPeng7/BiRefNet_lite, immutable revision
MODEL_REPO=onnx-community/BiRefNet_lite-ONNX
MODEL_REVISION=de15b22ba131738a16dff04aab8bdf8dc32e3ac1
MODEL_FILENAME=onnx/model.onnx
MODEL_SHA256=5600024376f572a557870a5eb0afb1e5961636bef4e1e22132025467d0f03333

# Starting CPU limits; NOT measured server benchmark values.
API_CPUS=3.0
API_MEMORY=3g
UI_CPUS=0.5
UI_MEMORY=256m
CPU_THREADS=2
MAX_CONCURRENT_INFERENCE=1
MAX_QUEUE_WAIT_SECONDS=10
MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=20000000
ENABLE_METRICS=true
